# Copie para api/.env e preencha. Nunca versione o .env.
PORT=3333
CORS_ORIGIN=http://localhost:3000

# Google Cloud Console > YouTube Data API v3 > Credenciais
YOUTUBE_API_KEY=
YOUTUBE_PLAYLIST_ID=PLjNlQ2vXx1xbt30X8TcUfNzw_akVISXEu
YOUTUBE_MAX_VIDEOS=20
# País do público (2 letras): a sync descarta vídeos bloqueados nele. Vazio desliga o filtro.
YOUTUBE_REGION=BR

# Supabase > Settings > API Keys (secret key sb_secret_..., só no back-end)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Texto aleatório com 32+ caracteres (ex.: node -e "console.log(crypto.randomBytes(32).toString('hex'))")
CRON_SECRET=

# Senha do Postgres, usada só pela CLI (supabase link / db push)
SUPABASE_DB_PASSWORD=
